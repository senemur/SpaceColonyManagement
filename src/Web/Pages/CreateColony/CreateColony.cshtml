@page "/CreateColony"
@model Web.Pages.CreateColony.CreateColonyModel

@{
    ViewData["Title"] = "Create Colony";
}

<div class="container mt-5">

    <h1>🚀 Create Your Colony</h1>

    <p>Humanity is waiting for you on Mars.</p>

    <form method="post">

        <div asp-validation-summary="All"
             class="text-danger">
        </div>

        <div class="mb-3">

            <label asp-for="ColonyName"
                   class="form-label">
                Colony Name
            </label>

            <input asp-for="ColonyName"
                   class="form-control"
                   placeholder="Enter colony name..." />

        </div>

        <button type="submit"
                class="btn btn-primary">
            🚀 Create Colony
        </button>

    </form>

</div>